# AuraSpace Environment Configuration Example
# Copy this file to .env and provide your actual API keys

# Backend API URL
VITE_API_URL=https://auraspace-backend.onrender.com

# OpenCage Geocoding API Key (for venue location mapping)
VITE_OPENCAGE_API_KEY=your_opencage_api_key_here

# Paystack Public Key (for payment processing in NGN)
VITE_PAYSTACK_API=pk_test_your_paystack_public_key
